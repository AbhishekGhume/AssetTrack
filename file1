using System.Globalization;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Logging;
using XmlMiddleware.Application.Configuration;
using XmlMiddleware.Application.Interfaces.Repositories;
using XmlMiddleware.Application.Interfaces.Services;
using XmlMiddleware.Application.Models;
using XmlMiddleware.Domain.Entities;
using XmlMiddleware.Domain.Enums;
using XmlMiddleware.Persistence.Context;

namespace XmlMiddleware.Infrastructure.Reconciliation;

/// <summary>
/// Scenario A reconciliation only: SQL says a batch completed and has its orders, but one or
/// more output formats are missing from blob storage (deleted by accident, storage issue,
/// etc.). Rebuilds just the missing formats from the persisted Order/Customer/Product data,
/// using EXACTLY the same folder/file naming the original run would have used, so the files
/// land back inside the batch's existing output folder rather than a new one.
///
/// This is only invoked reactively, from ProcessingFunction.CheckDuplicateAsync, when a
/// duplicate upload of an already-completed file is detected. There is no scheduled sweep.
/// </summary>
public class OutputReconciliationService : IOutputReconciliationService
{
    private readonly ApplicationDbContext _context;
    private readonly IProcessingBatchRepository _batchRepository;
    private readonly IOutputFileRepository _outputFileRepository;
    private readonly IBlobStorageService _blobStorageService;
    private readonly IFileGeneratorService _fileGeneratorService;
    private readonly IAuditService _auditService;
    private readonly ProcessingFolders _folders;
    private readonly ILogger<OutputReconciliationService> _logger;

    public OutputReconciliationService(
        ApplicationDbContext context,
        IProcessingBatchRepository batchRepository,
        IOutputFileRepository outputFileRepository,
        IBlobStorageService blobStorageService,
        IFileGeneratorService fileGeneratorService,
        IAuditService auditService,
        ProcessingFolders folders,
        ILogger<OutputReconciliationService> logger)
    {
        _context = context;
        _batchRepository = batchRepository;
        _outputFileRepository = outputFileRepository;
        _blobStorageService = blobStorageService;
        _fileGeneratorService = fileGeneratorService;
        _auditService = auditService;
        _folders = folders;
        _logger = logger;
    }

    public async Task<int> RegenerateMissingOutputsAsync(
        long batchId, CancellationToken ct = default)
    {
        var batch = await _batchRepository.GetByIdAsync(batchId, ct);

        if (batch is null)
        {
            _logger.LogWarning(
                "Reconciliation: batch {BatchId} not found - cannot check its outputs.", batchId);
            return 0;
        }

        if (batch.Status != BatchStatus.Completed && batch.Status != BatchStatus.PartialSuccess)
        {
            _logger.LogInformation(
                "Reconciliation: batch {BatchId} ({Status}) never finished successfully - nothing to regenerate.",
                batchId, batch.Status);
            return 0;
        }

        var outputs = await _outputFileRepository.GetByBatchIdAsync(batchId, ct);
        var missing = new List<OutputFile>();

        foreach (var output in outputs)
        {
            if (output.Status != OutputStatus.Success || !await OutputPhysicallyExistsAsync(output, ct))
            {
                missing.Add(output);
            }
        }

        if (missing.Count == 0)
        {
            _logger.LogInformation(
                "Reconciliation: batch {BatchId} ({FileName}) - all {Count} output format(s) are present. Nothing to do.",
                batchId, batch.FileName, outputs.Count);
            return 0;
        }

        _logger.LogWarning(
            "Reconciliation: batch {BatchId} ({FileName}) is missing {Count} output format(s) on disk that SQL says should exist: {Types}. Regenerating from the database.",
            batchId, batch.FileName, missing.Count, string.Join(", ", missing.Select(o => o.OutputType)));

        var orders = await LoadOrdersFromDatabaseAsync(batchId, ct);

        if (orders.Count == 0)
        {
            _logger.LogError(
                "Reconciliation: batch {BatchId} has no orders in the database - cannot regenerate its outputs.",
                batchId);
            return 0;
        }

        foreach (var output in missing)
        {
            await RegenerateOneFormatAsync(batch, output, orders, ct);

            _logger.LogInformation(
                "Reconciliation: regenerated {OutputType} for batch {BatchId} -> {Path}",
                output.OutputType, batchId, output.OutputBlobPath);
        }

        await _outputFileRepository.SaveChangesAsync(ct);

        await _auditService.LogEventAsync(
            batchId,
            batch.CorrelationId,
            batch.FileName,
            EventType.OutputsRegeneratedFromDatabase,
            "Success",
            $"{missing.Count} output format(s) ({string.Join(", ", missing.Select(o => o.OutputType))}) were missing from blob storage and were regenerated from the database.",
            nameof(OutputReconciliationService),
            batch.CurrentStep,
            batch.CurrentStep,
            0,
            null,
            null,
            null,
            ct);

        _logger.LogInformation(
            "Reconciliation: finished for batch {BatchId} - {Count} output format(s) regenerated.",
            batchId, missing.Count);

        return missing.Count;
    }

    private async Task<bool> OutputPhysicallyExistsAsync(OutputFile output, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(output.OutputBlobPath))
        {
            return false;
        }

        var relativePath = _folders.ToRelativePath(output.OutputBlobPath);

        if (output.OutputType == OutputType.Xlsx)
        {
            return await _blobStorageService.ExistsAsync(relativePath, ct);
        }

        var files = await _blobStorageService.ListAsync(relativePath, ct);
        return files.Count > 0;
    }

    private async Task<List<CanonicalOrderModel>> LoadOrdersFromDatabaseAsync(long batchId, CancellationToken ct)
    {
        var orders = await _context.Orders
            .Where(o => o.BatchId == batchId)
            .Include(o => o.Customer)
            .Include(o => o.OrderDetails)
                .ThenInclude(d => d.Product)
            .AsNoTracking()
            .ToListAsync(ct);

        return orders.Select(o => new CanonicalOrderModel
        {
            OrderId = o.OrderId,
            OrderDate = o.OrderDate.ToDateTime(TimeOnly.MinValue),
            CustomerId = o.Customer.CustomerId,
            FirstName = o.Customer.FirstName,
            LastName = o.Customer.LastName,
            Email = o.Customer.Email,
            AddressLine1 = o.AddressLine1,
            City = o.City,
            PostCode = o.PostCode,
            Country = o.Country,
            Items = o.OrderDetails
                .OrderBy(d => d.LineNumber)
                .Select(d => new CanonicalOrderItemModel
                {
                    ProductCode = d.Product.ProductCode,
                    ProductName = d.Product.ProductName,
                    Quantity = d.Quantity,
                    UnitPrice = d.UnitPrice
                })
                .ToList()
        }).ToList();
    }

    /// <summary>
    /// Rebuilds a missing format using EXACTLY the folder/file naming the normal pipeline
    /// would have used for this batch (same ReceivedDateTime-based timestamp, same
    /// safe-filename rules). This is what puts the regenerated files back inside the SAME
    /// parent folder as the formats that survived, with no "recovered" wording anywhere -
    /// and it's also naturally idempotent, since calling it twice produces the same paths.
    /// </summary>
    private async Task RegenerateOneFormatAsync(
        ProcessingBatch batch, OutputFile output, List<CanonicalOrderModel> orders, CancellationToken ct)
    {
        var safeFileName = MakeSafeFileName(Path.GetFileNameWithoutExtension(batch.FileName));
        var timestamp = batch.ReceivedDateTime.ToString("yyyyMMddHHmmssfff", CultureInfo.InvariantCulture);

        // Same shared parent folder the original run used for every format of this batch.
        var outputFolderName = $"{safeFileName}_{timestamp}";

        if (output.OutputType == OutputType.Xlsx)
        {
            using var generated = await _fileGeneratorService.GenerateAsync(orders, OutputType.Xlsx, ct);

            var relativePath = $"{_folders.Output.Trim('/')}/{outputFolderName}/{outputFolderName}.xlsx";

            await _blobStorageService.UploadAsync(generated, relativePath, ct);
            output.OutputBlobPath = _folders.ToFullPath(relativePath);
        }
        else
        {
            var extension = output.OutputType.ToString().ToLowerInvariant();
            var formatFolderName = $"{output.OutputType.ToString().ToUpperInvariant()}_{safeFileName}_{timestamp}";
            var formatFolderPath = $"{_folders.Output.Trim('/')}/{outputFolderName}/{formatFolderName}";

            foreach (var order in orders)
            {
                using var generated = await _fileGeneratorService.GenerateAsync([order], output.OutputType, ct);

                var safeOrderId = MakeSafeFileName(order.OrderId);
                var outputFileName = $"{safeOrderId}_{safeFileName}_{timestamp}.{extension}";
                var relativePath = $"{formatFolderPath}/{outputFileName}";

                await _blobStorageService.UploadAsync(generated, relativePath, ct);
            }

            output.OutputBlobPath = _folders.ToFullPath($"{formatFolderPath}/");
        }

        output.Status = OutputStatus.Success;
        output.AttemptCount++;
        output.CompletedDateTime = DateTime.UtcNow;
        output.ErrorCode = null;
        output.ErrorMessage = null;
    }

    private static string MakeSafeFileName(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Order";
        }

        var invalidCharacters = Path.GetInvalidFileNameChars();
        return new string(value.Select(c => invalidCharacters.Contains(c) ? '_' : c).ToArray());
    }
}