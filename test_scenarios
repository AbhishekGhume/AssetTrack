pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    parameters {
        string(
            name: 'PR_ID',
            defaultValue: 'manual',
            description: 'Pull Request ID'
        )
        string(
            name: 'COMMIT_SHA',
            defaultValue: 'none',
            description: 'Source commit SHA'
        )
    }

    environment {
        STORAGE_ACCOUNT = 'aitestagentstorage'
        RUN_ID          = "${env.BUILD_NUMBER}"
    }

    stages {

        // ============================================================
        // 1. Prepare working directory
        // ============================================================
        stage('Prepare') {
            steps {
                powershell '''
                if (Test-Path "work") {
                    Remove-Item "work" -Recurse -Force
                }
                New-Item -ItemType Directory -Path "work/scripts" -Force | Out-Null
                New-Item -ItemType Directory -Path "work/results" -Force | Out-Null
                Write-Host "Working directory prepared."
                '''
            }
        }

        // ============================================================
        // 2. Download ALL .jmx files from the container
        // ============================================================
        stage('Download JMX Files') {
            steps {
                withCredentials([
                    string(credentialsId: 'sas-test-script', variable: 'SAS_SCRIPTS')
                ]) {
                    powershell '''
                    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

                    $sas     = $env:SAS_SCRIPTS.TrimStart('?')
                    $base    = "https://$($env:STORAGE_ACCOUNT).blob.core.windows.net/test-scripts"
                    $listUri = "${base}?restype=container&comp=list&$sas"

                    try {
                        # List all blobs in the container (SAS needs Read + List permissions)
                        $resp  = Invoke-WebRequest -Uri $listUri -UseBasicParsing
                        $text  = $resp.Content
                        $xml   = [xml]($text.Substring($text.IndexOf('<')))
                        $blobs = @(
                            $xml.EnumerationResults.Blobs.Blob |
                                Where-Object { $_.Name -like '*.jmx' } |
                                ForEach-Object { $_.Name }
                        )

                        if ($blobs.Count -eq 0) {
                            throw "No .jmx files found in the test-scripts container."
                        }

                        Write-Host "JMX files found: $($blobs.Count)"

                        foreach ($blob in $blobs) {
                            $fileName = [IO.Path]::GetFileName($blob)
                            $encoded  = ($blob -split '/' | ForEach-Object { [Uri]::EscapeDataString($_) }) -join '/'

                            Invoke-WebRequest `
                                -Uri "$base/${encoded}?$sas" `
                                -OutFile "work/scripts/$fileName" `
                                -UseBasicParsing

                            Write-Host "Downloaded: $blob"
                        }
                    }
                    catch {
                        Write-Error "Failed to download JMX files."
                        Write-Error $_.Exception.Message
                        exit 1
                    }
                    '''
                }
            }
        }

        // ============================================================
        // 3. Run JMeter for every JMX + build run-summary.json
        // ============================================================
        stage('Run JMeter') {
            steps {
                powershell '''
                $jmeterExe = "D:/apache-jmeter-5.6.3/apache-jmeter-5.6.3/bin/jmeter.bat"

                $runs   = @()
                $failed = $false

                $jmxFiles = Get-ChildItem "work/scripts" -Filter "*.jmx"

                foreach ($jmx in $jmxFiles) {

                    $name   = $jmx.BaseName
                    $outDir = "work/results/$name"
                    New-Item -ItemType Directory -Path $outDir -Force | Out-Null

                    Write-Host ""
                    Write-Host "===== Running: $($jmx.Name) ====="

                    & $jmeterExe `
                        -n `
                        -t $jmx.FullName `
                        -l "$outDir/results.jtl" `
                        -j "$outDir/jmeter.log" `
                        -e `
                        -o "$outDir/html-report"

                    $exitCode = $LASTEXITCODE
                    Write-Host "JMeter Exit Code: $exitCode"

                    # ---------- Read statistics ----------
                    $stats     = $null
                    $statsPath = "$outDir/html-report/statistics.json"

                    if (Test-Path $statsPath) {
                        try {
                            $stats = Get-Content $statsPath -Raw | ConvertFrom-Json
                        }
                        catch {
                            Write-Warning "Could not read statistics.json for $name"
                            Write-Warning $_.Exception.Message
                        }
                    }

                    # ---------- Per-transaction stats (everything except Total) ----------
                    $transactions = [ordered]@{}
                    if ($null -ne $stats) {
                        $stats.PSObject.Properties |
                            Where-Object { $_.Name -ne "Total" } |
                            ForEach-Object { $transactions[$_.Name] = $_.Value }
                    }

                    # ---------- Status ----------
                    if ($exitCode -eq 0 -and $null -ne $stats) {
                        $status = "COMPLETED"
                    }
                    else {
                        $status = "ERROR"
                        $failed = $true
                    }

                    $runs += [ordered]@{
                        jmx          = $jmx.Name
                        status       = $status
                        exitCode     = $exitCode
                        overall      = $(if ($null -ne $stats) { $stats.Total } else { $null })
                        transactions = $transactions
                    }
                }

                # ---------- Build run-summary.json (the only file we upload) ----------
                $summary = [ordered]@{
                    runId           = $env:RUN_ID
                    prId            = $env:PR_ID
                    commitSha       = $env:COMMIT_SHA
                    status          = $(if ($failed) { "ERROR" } else { "COMPLETED" })
                    jenkinsBuildUrl = $env:BUILD_URL
                    totalJmxFiles   = $runs.Count
                    runs            = $runs
                }

                ConvertTo-Json -InputObject $summary -Depth 10 |
                    Set-Content "work/run-summary.json"

                Write-Host ""
                Write-Host "run-summary.json created."

                if ($failed) {
                    Write-Error "One or more JMeter runs failed."
                    exit 1
                }
                '''
            }
        }
    }

    // ============================================================
    // POST PROCESSING - upload only run-summary.json
    // ============================================================
    post {
        always {
            withCredentials([
                string(credentialsId: 'sas-reports', variable: 'SAS_REPORTS')
            ]) {
                powershell '''
                [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

                $summaryPath = "work/run-summary.json"

                if (-not (Test-Path $summaryPath)) {
                    Write-Warning "run-summary.json not found. Nothing to upload."
                    exit 0
                }

                # Example destination: PR-manual/run-10/run-summary.json
                $prId = $env:PR_ID
                if ([string]::IsNullOrWhiteSpace($prId)) { $prId = 'manual' }

                $sas = $env:SAS_REPORTS.TrimStart('?')
                $uri = "https://$($env:STORAGE_ACCOUNT).blob.core.windows.net/reports/PR-$prId/run-$($env:RUN_ID)/run-summary.json`?$sas"

                try {
                    Invoke-WebRequest `
                        -Uri $uri `
                        -Method Put `
                        -InFile $summaryPath `
                        -Headers @{ 'x-ms-blob-type' = 'BlockBlob' } `
                        -ContentType 'application/json' `
                        -UseBasicParsing |
                        Out-Null

                    Write-Host "Uploaded: PR-$prId/run-$($env:RUN_ID)/run-summary.json"
                }
                catch {
                    Write-Error "Failed to upload run-summary.json"
                    Write-Error $_.Exception.Message
                    exit 1
                }
                '''
            }
        }
    }
}
